# Copy to .env beside the compose file, then edit. .env is gitignored.

# ---------------------------------------------------------------- required
# The admin console password. Generate one:
#   openssl rand -base64 24 | tr -d '/+=' | head -c 32
VEIN_SERVER_ADMIN_PASSWORD=

# ---------------------------------------------------------------- the server
# The name players see in the server browser.
VEIN_SERVER_NAME=VEIN Server
# Empty: anyone who finds the server can join.
VEIN_SERVER_PASSWORD=
VEIN_SERVER_MAX_PLAYERS=16
# false: not in the public browser. Friends connect by address; see the
# README for why that address should be an IP, not a hostname.
VEIN_SERVER_PUBLIC=false
# Steam64 ids, comma-separated. Superadmins can run Save from the console.
VEIN_SERVER_ADMIN_STEAM_IDS=
VEIN_SERVER_SUPERADMIN_STEAM_IDS=

# ---------------------------------------------------------------- networking
# Published under the numbers the server binds and advertises, never
# translated. Change one here and both sides move with it.
VEIN_SERVER_PORT=7777
VEIN_SERVER_QUERY_PORT=27015

VEIN_SERVER_TIMEZONE=UTC

# ---------------------------------------------------------------- overridable defaults
# Everything below has a working default in the compose file; set it here only
# to change it, and the change survives every git pull.
#
# VEIN_SERVER_IMAGE_VERSION=v0.0.4@sha256:...
# VEIN_SERVER_IMAGE_TAG=mbround18/vein-docker:v0.0.4
#
# Optional: claims the server for your Steam account (app 1857950).
# VEIN_SERVER_STEAM_GSLT=
#
# 8g carried 16 slots on the machine this template comes from; 32 slots ran
# under 16g. Raise the limit with the slot count.
# VEIN_SERVER_MEMORY_LIMIT=8g
# VEIN_SERVER_CPU_LIMIT=4.0
# VEIN_SERVER_MEMORY_RESERVATION=4g
# VEIN_SERVER_CPU_RESERVATION=1.0
#
# The first start downloads about 10 GB of game through SteamCMD.
# VEIN_SERVER_START_PERIOD=60m
# The world is saved on the way out.
# VEIN_SERVER_STOP_GRACE_PERIOD=2m
# VEIN_SERVER_LOG_MAX_SIZE=10m
# VEIN_SERVER_LOG_MAX_FILE=3
#
# Backups (scripts/backup.sh): where archives go and how many are kept.
# VEIN_BACKUP_DIR=./backups
# VEIN_BACKUP_KEEP=14
